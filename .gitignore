node_modules/
dist/
coverage/
.vite/
test-results/
playwright-report/
docs/
*.log
.DS_Store

# Storybook's static output: built to serve story URLs to the harness, shots
# and the docs build — regenerated output, never committed.
apps/playground/storybook-static/

# Reference checkouts, kept read-only for porting. Never committed: 64 MB of
# vendored source across three checkouts.
references/
# Kept for the record: the pre-`references/` names, so a stray copy at the root
# still never enters history.
frappe-ui-main/
zag-main/

# vitest browser-mode screenshot captures. Nothing asserts against them (the
# suite has no screenshot matcher), so they are regenerated output, not
# baselines.
__screenshots__/

# Local agent tooling and Impeccable review artifacts. The design-system
# sidecar (DESIGN.md and .impeccable/design.json) is committed; live sessions,
# critique captures and per-app review output are local state.
.opencode/
.github/agents/
.github/skills/
.impeccable/config.local.json
.impeccable/critique/
.impeccable/live/
.impeccable/review/
apps/playground/.impeccable/
