{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!**/references",
      "!**/packages/tailwind/src/generated",
      "!**/playground/src/generated"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "domains": { "solid": "recommended", "test": "recommended" },
    "rules": {
      "preset": "recommended",
      // Conflicts with `noPropertyAccessFromIndexSignature` (tsconfig): Biome
      // wants `obj.id`, TypeScript requires `obj['id']` on an index signature.
      // The type-level rule is the stricter one, so Biome yields.
      "complexity": { "useLiteralKeys": "off" },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": { "allow": ["warn", "error"] }
        }
      },
      "style": { "noRestrictedImports": "error" }
    }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      // A scroll viewport is a tab stop by contract (WCAG 2.1.1), not by
      // accident: a region that scrolls and cannot be reached from the keyboard
      // is the defect `scrollable-region-focusable` names. The lint rule assumes
      // `tabindex` on a non-interactive element is a mistake; here it is the fix.
      "includes": ["packages/ui/src/components/ScrollArea/**"],
      "linter": {
        "rules": { "a11y": { "noNoninteractiveTabindex": "off" } }
      }
    },
    {
      // The drawer's backdrop click. The keyboard path is the `<dialog>`'s own
      // Escape, which the element already owns — there is no second keyboard
      // affordance to add, and a key handler on the backdrop would be a
      // duplicate that fires on Enter anywhere in the panel.
      "includes": ["packages/ui/src/components/ResponsiveShell/**"],
      "linter": {
        "rules": { "a11y": { "useKeyWithClickEvents": "off" } }
      }
    },
    {
      // A command palette is a WAI-ARIA combobox: focus stays in the field and
      // the active option is named by `aria-activedescendant`. Three rules
      // assume focus moves onto the option itself, which is precisely what the
      // pattern avoids — a focusable option would pull focus out of the field
      // the moment you arrow down. `useSemanticElements` has nothing to offer
      // either: the options are rich rows rebuilt on every keystroke.
      "includes": ["packages/ui/src/components/CommandPalette/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      // A window splitter is a *widget* separator: WAI-ARIA's `separator` with
      // `aria-valuenow`, a tab stop and arrow keys. `useSemanticElements`
      // suggests `<hr>`, which is a static rule — it carries no value, takes no
      // focus and has no keyboard handler, so there is nothing to suggest.
      "includes": ["packages/layouts/src/PaneLayout/**"],
      "linter": {
        "rules": { "a11y": { "useSemanticElements": "off" } }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.browser.test.tsx",
        "**/*.ssr.test.tsx",
        "**/mocks/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "off",
              "options": { "allow": ["warn", "error"] }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tailwind/src/utilities.css"],
      "linter": {
        "rules": { "complexity": { "noImportantStyles": "off" } }
      }
    },
    {
      // `Error` is a required state-story name (spec/states.md): the export is
      // a Storybook story, not a shadow of the global constructor.
      "includes": ["apps/playground/src/stories/**"],
      "linter": {
        "rules": {
          "suspicious": { "noShadowRestrictedNames": "off" }
        }
      }
    },
    {
      // A listbox may contain only options and groups (axe's
      // `aria-required-children`), and the loading/empty placeholder is a
      // disabled *option*. Options are addressed by `aria-activedescendant`
      // and stay unfocusable on purpose (focus never leaves the field), which
      // is the same carve-out the CommandPalette documents above.
      "includes": [
        "packages/ui/src/components/Combobox/**",
        "packages/ui/src/components/MultiSelect/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
