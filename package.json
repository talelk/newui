{
  "name": "newui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @newui/tailwind build",
    "build:playground": "pnpm --filter playground build",
    "verify": "tsx scripts/ci.ts",
    "verify:affected": "tsx scripts/ci.ts --affected",
    "verify:checks": "tsx scripts/ci.ts --group=checks",
    "verify:e2e": "tsx scripts/ci.ts --group=e2e",
    "test": "vitest run",
    "test:sweep": "vitest run --config vitest.sweep.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:component": "vitest run --project component",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:solid": "eslint .",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "packages:check": "for p in packages/*; do publint \"$p\" --strict || exit 1; done",
    "knip": "knip",
    "size": "tsx scripts/size.ts",
    "test:e2e": "playwright test",
    "css": "pnpm --filter @newui/tailwind build:css",
    "api": "tsx scripts/propsgen.ts",
    "site": "tsx scripts/sitegen.ts",
    "site:check": "tsx scripts/sitegen.ts --check",
    "api:check": "tsx scripts/propsgen.ts --check",
    "specs:check": "tsx scripts/check-specs.ts",
    "refs:check": "tsx scripts/check-references.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "budget": "tsx scripts/budget.ts",
    "shots": "tsx scripts/shots.ts",
    "review": "tsx scripts/visual-review.ts",
    "docs:build": "tsx scripts/docs.ts",
    "css:check": "tsx scripts/check-css.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "^4.14.0",
    "culori": "^4.0.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.3",
    "knip": "^6.41.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "solid-js": "^1.9.17",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.5"
  }
}
