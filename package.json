{
  "name": "newui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter @newui/tailwind build",
    "build:playground": "pnpm --filter playground build",
    "verify": "tsx scripts/ci.ts",
    "verify:checks": "tsx scripts/ci.ts --group=checks",
    "verify:e2e": "tsx scripts/ci.ts --group=e2e",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:component": "vitest run --project component",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:solid": "eslint .",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "packages:check": "for p in packages/*; do publint \"$p\" --strict || exit 1; done",
    "knip": "knip",
    "size": "tsx scripts/size.ts",
    "test:e2e": "playwright test",
    "css": "pnpm --filter @newui/tailwind build:css",
    "api": "tsx scripts/propsgen.ts",
    "api:check": "tsx scripts/propsgen.ts --check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "docs:build": "tsx scripts/docs.ts",
    "css:check": "tsx scripts/check-css.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.64.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "axe-core": "^4.10.0",
    "culori": "^4.0.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^26.0.0",
    "knip": "^5.60.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.50.0",
    "publint": "^0.3.25",
    "solid-js": "^1.9.0",
    "ts-morph": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.0"
  }
}
