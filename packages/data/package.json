{
  "name": "@newui/data",
  "version": "0.0.0",
  "type": "module",
  "description": "The logic layer: formatting, selection, undo and downloads \u2014 no components.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talelk/newui.git",
    "directory": "packages/data"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "default": "./src/query/index.ts"
    },
    "./form": {
      "types": "./src/form/index.ts",
      "default": "./src/form/index.ts"
    },
    "./resource": {
      "types": "./src/resource/index.ts",
      "default": "./src/resource/index.ts"
    }
  },
  "files": [
    "src",
    "skills"
  ],
  "keywords": [
    "tanstack-intent",
    "agent-skills",
    "solidjs",
    "data"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "^5.104.3"
  },
  "license": "Apache-2.0"
}
