{
  "name": "@newui/data",
  "version": "0.0.0",
  "type": "module",
  "description": "The logic layer: formatting, selection, undo and downloads \u2014 no components.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "default": "./src/query/index.ts"
    },
    "./form": {
      "types": "./src/form/index.ts",
      "default": "./src/form/index.ts"
    },
    "./table": {
      "types": "./src/table/index.ts",
      "default": "./src/table/index.ts"
    },
    "./table/scroll": {
      "types": "./src/table/scroll.ts",
      "default": "./src/table/scroll.ts"
    },
    "./virtual": {
      "types": "./src/virtual/index.ts",
      "default": "./src/virtual/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@newui/ui": "workspace:*",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "^5.104.3",
    "@tanstack/solid-table": "^9.3.1",
    "@tanstack/solid-virtual": "^3.13.47"
  }
}
