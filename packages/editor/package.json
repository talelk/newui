{
  "name": "@talelk/newui-editor",
  "version": "0.1.0",
  "type": "module",
  "description": "A TipTap (ProseMirror) rich-text editor as a Solid component, themed with the newui design tokens.",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.17"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talelk/newui.git",
    "directory": "packages/editor"
  }
}
