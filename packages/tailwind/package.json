{
  "name": "@newui/tailwind",
  "version": "0.0.1",
  "type": "module",
  "description": "Tailwind CSS v4 layer: the newui design tokens as @theme, @utility and plugins.",
  "exports": {
    "./style.css": {
      "style": "./src/style.css",
      "import": "./src/style.css"
    },
    "./source": {
      "types": "./src/source.d.ts",
      "default": "./src/source.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsx scripts/build-css.ts",
    "build:css": "tsx scripts/build-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@newui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "lucide-static": "^1.31.0",
    "tailwindcss": "^4.1.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "sideEffects": false
}
