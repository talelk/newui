{
  "name": "@newui/tailwind",
  "version": "0.0.1",
  "type": "module",
  "description": "Tailwind CSS v4 layer: the newui design tokens as @theme, @utility and plugins.",
  "exports": {
    "./style.css": {
      "style": "./src/style.css",
      "import": "./src/style.css"
    },
    "./source": {
      "types": "./src/source.d.ts",
      "default": "./src/source.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsx scripts/build-css.ts",
    "build:css": "tsx scripts/build-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@newui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "lucide-static": "^1.57.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talelk/newui.git",
    "directory": "packages/tailwind"
  }
}
